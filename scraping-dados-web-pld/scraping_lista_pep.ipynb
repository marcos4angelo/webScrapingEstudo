    "import requests\n",
    "\n",
    "url = \"https://portaldatransparencia.gov.br/download-de-dados/pep/202502\"\n",
    "\n",
    "response = requests.get(url)\n",
    "\n",
    "# Save file\n",
    "with open(\"bronze/lista_pep.zip\", \"wb\") as f:\n",
    "    f.write(response.content)"
